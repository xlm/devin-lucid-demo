#!/usr/bin/env bash
# Compiles the legacy processor and records the replay runtime classpath.
# Spark is a Provided dependency, so it is not on that classpath.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$HERE"

SBT="$(command -v sbt || true)"
if [[ -z "$SBT" && -x "$HOME/.local/sbt/bin/sbt" ]]; then
  SBT="$HOME/.local/sbt/bin/sbt"
fi
if [[ -z "$SBT" ]]; then
  echo "legacy-scala/bin/build: sbt not found on PATH or in ~/.local/sbt" >&2
  exit 1
fi

mkdir -p target
out="$("$SBT" -batch -Dsbt.supershell=false -Dsbt.color=false compile "export Runtime/fullClasspath" </dev/null)" || {
  printf '%s\n' "$out" >&2
  exit 1
}
classpath="$(printf '%s\n' "$out" | tail -n 1)"
if [[ "$classpath" != *ujson* ]]; then
  printf '%s\n' "$out" >&2
  echo "legacy-scala/bin/build: could not read the runtime classpath from sbt" >&2
  exit 1
fi
printf '%s\n' "$classpath" > target/replay-classpath.txt
echo "legacy-scala/bin/build: classpath written to target/replay-classpath.txt" >&2
